generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id       String    @id @default(uuid())
  name     String
  settings String?
  clients  Client[]
  routes   Route[]
  users    User[]
  vehicles Vehicle[]
}

model User {
  id           String     @id @default(uuid())
  tenantId     String
  username     String     @unique
  password     String
  fullName     String
  role         String     @default("DRIVER")
  payType      String? // "FIJO" | "JORNAL" para AUXILIAR. null = todavia sin identificar
  /// Para las fichas de CHOFER: "PROPIO" | "TERCERIZADO". null = todavia sin
  /// identificar. Hace falta un campo propio porque providerId vacio no alcanza:
  /// no distingue "es de la casa" de "nadie lo definio todavia".
  contractType String?
  /// Baja: la persona ya no trabaja. No se borra para no perder el historial
  /// ni lo que se hubiera identificado de ella; deja de ofrecerse en los
  /// desplegables y en Personal, y no se puede volver a crear con ese nombre.
  active       Boolean    @default(true)
  pushToken    String? // Token Expo para notificaciones push
  /// Si tiene un proveedor asignado, sus viajes se consideran Tercerizados.
  /// Si es null, sus viajes son Propios.
  providerId   String?
  createdAt    DateTime   @default(now())
  driverRoutes Route[]    @relation("DriverRoutes")
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  provider     Provider?  @relation(fields: [providerId], references: [id])
  incidents    Incident[]

  @@index([providerId])
}

/// Proveedores tercerizados (transportistas externos).
/// Un chofer/auxiliar con providerId asignado realiza viajes Tercerizados de ese proveedor.
model Provider {
  id        String   @id @default(uuid())
  tenantId  String   @default("default-tenant")
  name      String   @unique
  cuit      String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Vehicle {
  id              String    @id @default(uuid())
  tenantId        String
  plate           String    @unique
  model           String?
  capacityWeight  Float?
  capacityVolume  Float?
  isRefrigerated  Boolean   @default(false)
  status          String    @default("ACTIVE")
  contractType    String?
  driverName      String?
  fuelType        String?
  insurance       String?
  usefulLife      String?
  vehicleType     String?
  currentKm       Float? // Kilometraje actual (actualizado por chofer al iniciar recorrido)
  /// Papeles y datos de la unidad. Antes vivian solo en el navegador del
  /// operador (localStorage): se perdian al limpiar el navegador y nadie mas
  /// los veia. Ahora quedan en la base.
  vtvExpiry       DateTime?
  insuranceExpiry DateTime?
  senasaExpiry    DateTime?
  /// Texto libre: a veces dice "VENCIDO (falta curso...)" en vez de una fecha.
  bromatologia    String?
  driverLicense   String?
  brand           String?
  year            Int?
  motor           String?
  chasis          String?
  routes          Route[]
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
}

model Client {
  id                    String                 @id @default(uuid())
  tenantId              String
  name                  String
  address               String?
  latitude              Float?
  longitude             Float?
  timeWindowStart       String?
  timeWindowEnd         String?
  serviceTime           Int                    @default(15)
  zone                  String?
  priority              Int                    @default(0)
  barrio                String?
  requiresProofPhoto    Boolean                @default(false) // Si es true, la app móvil exige foto al entregar
  /// Menú asignado al establecimiento (ej: "General", "Patológico Celíaco", etc.)
  menu                  String?
  /// Cupos por tipo (JSON): { dmcGeneral, comedorGeneral, viandasGeneral, listoConsumoGeneral, dmcCeliaco, dmcDiabetico, dmcIntLactosa, dmcBajoSodio, dmcAlergiaMani, comedorCeliaco, comedorDiabetico, comedorIntLactosa, comedorBajoSodio, comedorAlergiaMani }
  cupos                 String?
  /// Unidades de negocio del cliente con su reparto (JSON array): [{ "unidad": "SAE", "reparto": "5" }, { "unidad": "Patios", "reparto": "14" }]
  businessUnits         String?
  /// Tipo de establecimiento: Proveedor | Escuela | Institución Pública | Comunitario | Comedor | Institución Religiosa | Club
  tipo                  String?
  /// Localidad (ej: "Don Orione", "Bernal")
  localidad             String?
  /// Partido al que pertenece (ej: "Almirante Brown", "Quilmes")
  partido               String?
  /// Contacto en el establecimiento: nombre de la persona
  contactName           String?
  /// Personal del contacto: quien es en el establecimiento (directora, portero, cocinera...)
  contactStaff          String?
  /// Telefono del contacto
  contactPhone          String?
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  stops                 Stop[]
  establishmentMappings EstablishmentMapping[]
}

model Route {
  id                Int       @id @default(autoincrement())
  tenantId          String
  date              DateTime
  status            String    @default("PLANNED")
  vehicleId         String?
  driverId          String?
  tripId            Int?      @unique
  totalKm           Float?
  estimatedTime     Int?
  actualStartTime   DateTime?
  actualEndTime     DateTime?
  /// Justificación del chofer al reordenar paradas
  reorderReason     String?
  /// Fecha/hora en que el chofer reordenó las paradas
  reorderedAt       DateTime?
  /// Nombre del chofer que reordenó (snapshot)
  reorderedByDriver String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  driver            User?     @relation("DriverRoutes", fields: [driverId], references: [id])
  vehicle           Vehicle?  @relation(fields: [vehicleId], references: [id])
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  trip              Trip?     @relation(fields: [tripId], references: [id])
  stops             Stop[]

  @@index([date])
  @@index([status])
}

model Stop {
  id                    Int       @id @default(autoincrement())
  routeId               Int
  clientId              String
  sequence              Int
  /// Secuencia original asignada por el planificador (antes de reordenamiento del chofer)
  plannedSequence       Int?
  plannedEta            DateTime?
  actualArrival         DateTime?
  actualDeparture       DateTime?
  status                String    @default("PENDING")
  reasonCode            String?
  observations          String?
  proofPhotoUrl         String?
  /// true = chofer marcó «entrega sin problemas»; null = no indicado
  deliveryWithoutIssues Boolean?
  signatureUrl          String?
  /// true = parada de retorno al depósito (Real de Catorce). Al marcarla como
  /// finalizada, el viaje se cierra automáticamente con ESA hora.
  isReturnToBase        Boolean   @default(false)
  /// Veces que el chofer pasó y no pudo entregar, eligiendo volver más tarde.
  /// status='RETRY' = pospuesta, sigue pendiente y bloquea el cierre del viaje.
  retryCount            Int       @default(0)
  /// Bitácora de los intentos fallidos: [{at, reason, note}] en JSON.
  retryLog              Json?
  /// Cajones que el chofer DEJÓ en el establecimiento en esta parada (null = no lo cargó)
  cratesDelivered       Int?
  /// Cajones que el chofer RECUPERÓ (vacíos) en esta parada (null = no lo cargó)
  cratesRecovered       Int?
  /// Última vez que se tocaron los cajones. Sirve para detectar el retiro tardío:
  /// el chofer vuelve más tarde a buscar los cajones, con la entrega ya cerrada.
  cratesUpdatedAt       DateTime?
  /// Cajones abiertos por tipo de envase. Es lo que el chofer carga en la app:
  /// cuantos dejo y cuantos recupero de cada uno. Tres llevan el nombre del
  /// proveedor del envase (Peco, Plasticos, Burzaco) y dos son envases propios
  /// (la jaula y los cajones del deposito). Los totales de arriba
  /// (cratesDelivered / cratesRecovered) son la SUMA de todos y los calcula el
  /// servidor, para que ningun reporte viejo quede sin dato.
  /// null = el chofer no lo cargo; 0 = lo cargo y no hubo envases de ese tipo.
  cratesDeliveredPeco      Int?
  cratesRecoveredPeco      Int?
  cratesDeliveredPlasticos Int?
  cratesRecoveredPlasticos Int?
  cratesDeliveredBurzaco   Int?
  cratesRecoveredBurzaco   Int?
  cratesDeliveredJaula     Int?
  cratesRecoveredJaula     Int?
  cratesDeliveredDeposito  Int?
  cratesRecoveredDeposito  Int?
  /// De que ruta del viaje es esta parada ("R8", "R12"). Un viaje puede tener
  /// varias rutas y la vuelta al deposito; sin esto no hay forma de cerrarlas
  /// de a una. null = viaje de una sola ruta, como fue siempre.
  ruta                  String?
  client                Client    @relation(fields: [clientId], references: [id])
  route                 Route     @relation(fields: [routeId], references: [id])

  @@index([status])
  @@index([routeId, ruta])
}

model Trip {
  id                 Int            @id @default(autoincrement())
  date               DateTime
  priority           String?
  zone               String?
  vehicle            String?
  driver             String?
  provider           String?
  auxiliar           String?
  auxiliar2          String?
  auxiliar3          String?
  businessUnit       String?
  distributionType   String?
  contractType       String?
  vehicleType        String?
  tripType           String?
  entryTime          String?
  exitTime           DateTime?
  returnTime         DateTime?
  value              Decimal?       @default(0)
  paymentStatus      String?
  paymentDate        DateTime?
  observations       String?
  notes              String?
  status             String         @default("PENDING") // PENDING, OUT_OF_PLANT, RETURNED, COMPLETED
  startedAt          DateTime?
  completedAt        DateTime?
  driverComments     String?
  proofPhotoUrl      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  arrivalTime        String?
  departureTime      String?
  isRefrigerated     Boolean?
  kmArrival          String?
  kmDeparture        String?
  reason             String?
  temperature        String?
  reparto            String?
  /// Las rutas que hace el viaje, en orden: ["R8","R12","CIC 1"]. `reparto`
  /// sigue siendo la primera, que es la que usan los filtros, la app del
  /// chofer y la subzona. Esta lista existe para mostrarlas todas.
  rutas              Json?
  assignedMobileUser String?
  locality           String?
  /// 1 = primera vuelta del día (costo auxiliar jornal completo); 2 o 3 = siguientes (misma regla de costo). null = calcular por hora/patente (legacy).
  vuelta             Int?
  /// Viaje manual: no va a ningun celular y no se le toman tiempos parada por
  /// parada. Solo la hora de salida y la de llegada, cargadas por el operador.
  isManual           Boolean        @default(false)
  /// Subzona del Excel GASTOS TRAFICO (ej. "Zona 4"). Se completa sola a partir
  /// del reparto: no se muestra ni se edita, existe para los reportes.
  subzona            String?
  /// Campos que el operador agrego por su cuenta desde "Campos del viaje".
  /// { "id-del-campo": valor }. Van aca para no tener que tocar la tabla cada
  /// vez que alguien necesita un dato nuevo.
  camposExtra        Json?
  stops              TripStop[]
  locations          TripLocation[]
  linkedRoute        Route?
  tramos             TripLeg[]
  cajones            CrateMovement[]

  @@index([date])
  @@index([driver])
  @@index([status])
}

model TripStop {
  id              Int       @id @default(autoincrement())
  tripId          Int
  name            String
  clientId        String?
  sequence        Int
  actualArrival   DateTime?
  actualDeparture DateTime?
  status          String    @default("PENDING") // PENDING, ARRIVED, COMPLETED, FAILED
  observations    String?
  failedReason    String? // Checkbox/Text for why it failed
  latitude        Float?
  longitude       Float?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model TripLocation {
  id        Int      @id @default(autoincrement())
  tripId    Int
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model RouteTemplate {
  id        String              @id @default(uuid())
  name      String              @unique
  /// La unidad de negocio a la que pertenece esta ruta ("SAE BROWN", "SAM").
  /// Un viaje que carga varias rutas se queda con la union de sus unidades, y
  /// cada parada sabe de cual es por la ruta de la que vino. De aca salen los
  /// bloques de la lista de paradas y las horas de cada unidad.
  businessUnit String?
  stops     RouteStopTemplate[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model RouteStopTemplate {
  id              String        @id @default(uuid())
  routeTemplateId String
  name            String
  sequence        Int
  routeTemplate   RouteTemplate @relation(fields: [routeTemplateId], references: [id], onDelete: Cascade)

  @@index([routeTemplateId])
}

model EmployeeSalary {
  id          String   @id @default(uuid())
  month       String
  firstName   String?
  lastName    String
  role        String?
  grossSalary Float?   @default(0)
  dailyWage   Float?   @default(0)
  seniority   Int?     @default(0)
  baseScale   Float?   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, lastName])
}

model MaintenanceRecord {
  id        String   @id @default(uuid())
  plate     String
  category  String?
  month     String?
  date      String?
  mileage   Float?
  workshop  String?
  workDone  String?
  cost      Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Las horas de cada tramo de un viaje: cada ruta por separado y la vuelta al
/// deposito.
///
/// Hasta ahora un viaje tenia UN solo par de horarios (Route.actualStartTime /
/// actualEndTime), asi que no habia donde guardar cuanto duro cada ruta cuando
/// el viaje hace dos o tres. Un tramo cerrado no se mueve mas.
///
/// La suma de los tramos da el total del viaje: el tramo N+1 arranca justo
/// cuando se cerro el N, sin huecos.
model TripLeg {
  id        String    @id @default(uuid())
  tripId    Int
  /// 1, 2, 3... El orden en que se recorren. La vuelta al deposito es el ultimo.
  orden     Int
  /// "R8", "R12", o VUELTA_AL_DEPOSITO para el tramo final.
  ruta      String
  inicio    DateTime?
  fin       DateTime?
  /// Por que se cerro con paradas sin marcar. Lo escribe el chofer.
  motivo    String?
  /// Quien lo cerro: el chofer desde el celular o el operador desde la web.
  cerradoPor String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, orden])
  @@index([tripId])
}

model AppSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Alert {
  id        String   @id @default(uuid())
  tenantId  String?  @default("default-tenant")
  type      String // 'info', 'warning', 'critical', 'success'
  title     String
  text      String
  timeLabel String? // 'Ahora', '2 horas', etc.
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Repartos (desde Excel): nombre del reparto + establecimientos
model Reparto {
  id        String                 @id @default(uuid())
  name      String // nombre del reparto (col 1 Excel)
  tenantId  String                 @default("default-tenant")
  createdAt DateTime               @default(now())
  stops     RepartoEstablishment[]
}

model RepartoEstablishment {
  id        Int     @id @default(autoincrement())
  repartoId String
  excelName String // nombre en el Excel (col 2)
  sequence  Int     @default(0)
  reparto   Reparto @relation(fields: [repartoId], references: [id], onDelete: Cascade)

  @@index([repartoId])
}

// Mapeo: nombre del Excel -> cliente del sistema (para los que no coinciden exactamente)
model EstablishmentMapping {
  id        String @id @default(uuid())
  excelName String @unique // nombre tal como viene en el Excel
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Incidencias reportadas por choferes desde la app móvil
model Incident {
  id          String    @id @default(uuid())
  driverId    String
  tripId      Int?
  type        String // MECANICO | TRANSITO | ESCUELA | OTRO
  description String
  photoUrl    String?
  status      String    @default("OPEN") // OPEN | CLOSED
  resolution  String?
  createdAt   DateTime  @default(now())
  closedAt    DateTime?
  driver      User      @relation(fields: [driverId], references: [id])

  @@index([status])
  @@index([driverId])
  @@index([createdAt])
}

// Registro de auditoría: quién hizo qué y cuándo
model AuditLog {
  id         String   @id @default(uuid())
  userId     String? // null si fue acción de sistema
  userName   String? // nombre visible del usuario
  action     String // CREATE | UPDATE | DELETE
  entity     String // trip | route | vehicle | user | client | route-template | maintenance
  entityId   String? // id del registro afectado
  entityName String? // nombre legible (ej. "GARCIA" para un viaje)
  before     String? // JSON del estado anterior (para UPDATE/DELETE)
  after      String? // JSON del estado nuevo (para CREATE/UPDATE)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@index([userId])
}

// Rastreo satelital: ubicaciones enviadas por la app móvil de choferes
model DeviceLocation {
  id             String    @id @default(uuid())
  deviceId       String // identificador estable del dispositivo
  deviceLabel    String? // nombre visible (ej. chofer)
  driverId       String? // User.id del chofer (cuando la app lo envía)
  routeId        Int? // Route.id del recorrido activo
  latitude       Float
  longitude      Float
  accuracy       Float? // precisión GPS (m)
  speed          Float? // m/s si el cliente lo envía
  heading        Float? // grados
  offRouteMeters Float? // distancia mínima a la polilínea planificada (m), si aplica
  capturedAt     DateTime? // timestamp real del GPS en el dispositivo (enviado por la app)
  timestamp      DateTime  @default(now())
  createdAt      DateTime  @default(now())
  /// false = recorrido finalizado o viaje borrado; se conserva para historial pero no aparece en el mapa en vivo
  isActive       Boolean   @default(true)

  @@index([deviceId])
  @@index([timestamp])
  @@index([routeId, timestamp])
  @@index([driverId])
  @@index([isActive, timestamp])
}

// Historial de cambios visibles para el negocio (menú, cupos, datos de establecimiento)
// Más legible y filtrable que AuditLog (que es técnico). Se muestra en la solapa "Historial".
model Historial {
  id         String   @id @default(uuid())
  clientId   String? // Client.id afectado (si aplica)
  clientName String? // nombre del establecimiento al momento del cambio
  category   String // MENU | CUPOS | DATOS
  field      String // ej: "menu", "cupos_general", "cupos_celiaco", "address", "name"
  oldValue   String? // valor anterior (como string)
  newValue   String? // valor nuevo (como string)
  userId     String? // usuario que hizo el cambio
  userName   String? // nombre visible del usuario
  note       String? // observación opcional
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@index([category])
  @@index([createdAt])
}


/// Un tipo de cajon del deposito. Arranca con los cinco que ya usa la app del
/// chofer (Peco, Plasticos, Burzaco, Jaula, Cajones del deposito) y se pueden
/// agregar mas sin tocar el codigo.
model CrateType {
  id          Int             @id @default(autoincrement())
  /// Clave estable, la misma que usa la app: peco, plasticos, burzaco...
  key         String          @unique
  name        String
  orden       Int             @default(0)
  activo      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  movimientos CrateMovement[]
}

/// Cada entrada y salida de cajones del deposito.
///
/// El stock de un tipo es la SUMA de `cantidad` de todos sus movimientos.
/// Positivo = entra al deposito, negativo = sale. Un inventario no fija el
/// numero a lo bruto: guarda la diferencia contra lo que decia el sistema, asi
/// nunca se pierde el rastro de por que cambio el stock.
model CrateMovement {
  id        Int       @id @default(autoincrement())
  typeId    Int
  fecha     DateTime  @default(now())
  /// INVENTARIO | SALIDA | RETORNO | COMPRA | BAJA | AJUSTE
  motivo    String
  cantidad  Int
  /// Solo en INVENTARIO: lo que se conto fisicamente.
  contado   Int?
  /// SALIDA y RETORNO van atadas al viaje que se los llevo.
  tripId    Int?
  nota      String?
  usuario   String?
  createdAt DateTime  @default(now())
  type      CrateType @relation(fields: [typeId], references: [id])
  trip      Trip?     @relation(fields: [tripId], references: [id])

  @@index([typeId, fecha])
  @@index([tripId, motivo])
  @@index([motivo, fecha])
}
